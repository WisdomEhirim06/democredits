{
    "info": {
        "name": "Demo Credits API",
        "description": "API collection for the Demo Credit Wallet Service.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "1. Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    var data = pm.response.json();",
                                    "    if (data.data && data.data.token) {",
                                    "        pm.collectionVariables.set(\"auth_token\", data.data.token);",
                                    "        console.log(\"Saved auth_token to collection variables.\");",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"password\": \"securepassword123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Registers a new user and automatically saves the resulting JWT token."
                    },
                    "response": []
                },
                {
                    "name": "2. Register 2nd User (For Transfers)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"seconduser@example.com\",\n  \"first_name\": \"Second\",\n  \"last_name\": \"User\",\n  \"password\": \"securepassword123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Registers a second user so you have someone to transfer funds to."
                    },
                    "response": []
                },
                {
                    "name": "3. Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var data = pm.response.json();",
                                    "    if (data.data && data.data.token) {",
                                    "        pm.collectionVariables.set(\"auth_token\", data.data.token);",
                                    "        console.log(\"Saved auth_token to collection variables.\");",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"securepassword123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Logs in the user and saves the JWT token."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Wallet Operations",
            "item": [
                {
                    "name": "4. Fund Wallet",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"amount\": 50000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/wallet/fund",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallet",
                                "fund"
                            ]
                        },
                        "description": "Funds the authenticated user's wallet."
                    },
                    "response": []
                },
                {
                    "name": "5. Get Balance",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/wallet/balance",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallet",
                                "balance"
                            ]
                        },
                        "description": "Retrieves the current balance of the authenticated user."
                    },
                    "response": []
                },
                {
                    "name": "6. Transfer Funds",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"recipient_email\": \"seconduser@example.com\",\n  \"amount\": 15000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/wallet/transfer",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallet",
                                "transfer"
                            ]
                        },
                        "description": "Transfers funds to another user by email."
                    },
                    "response": []
                },
                {
                    "name": "7. Withdraw Funds",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"amount\": 5000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/wallet/withdraw",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallet",
                                "withdraw"
                            ]
                        },
                        "description": "Withdraws funds from the authenticated user's wallet."
                    },
                    "response": []
                },
                {
                    "name": "8. Get Transactions History",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/wallet/transactions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "wallet",
                                "transactions"
                            ]
                        },
                        "description": "Gets the transaction history for the authenticated user."
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "auth_token",
            "value": "",
            "type": "string"
        }
    ]
}